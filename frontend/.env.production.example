# OmniAI Production Frontend Configuration
# When deployed with Docker Compose and Nginx, leave blank for relative reverse-proxy routing:
VITE_API_BASE_URL=""

# If deploying frontend and backend to distinct domains or CDN:
# VITE_API_BASE_URL="https://api.omniai.example.com"

# Optional: Pre-configured Access Token if backend APP_ACCESS_TOKEN is required
# VITE_ACCESS_TOKEN="your-secure-access-token"


