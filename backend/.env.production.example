# ==============================================================================
# OmniAI Production Environment Configuration (Render + Neon PostgreSQL)
# ==============================================================================

# Application & Environment
APP_NAME=OmniAI Backend
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
ENABLE_DOCS=false

# Port is automatically assigned by Render via $PORT (defaults to 8000 locally)
PORT=8000
HOST=0.0.0.0

# Database: Neon Serverless PostgreSQL (Use the pooled connection string)
# Obtain from Neon Console (https://console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Frontend & CORS Configuration
# Set to your exact Vercel production domain
FRONTEND_URL=https://omniai.aniket-agr2007.workers.dev
CORS_ORIGINS=https://omniai.aniket-agr2007.workers.dev

# Server Secrets (Generate strong random 32+ character strings)
APP_SESSION_SECRET=generate_a_random_32_character_secret_here
API_KEY_ENCRYPTION_SECRET=generate_a_random_32_character_secret_here

# AI Provider API Keys
# Google AI Studio (Free: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...
# Groq Cloud (Free: https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://omniai-backend-qg4l.onrender.com/api/auth/oauth/google/callback

# GitHub OAuth App Credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=Ov23...
GITHUB_CLIENT_SECRET=ghs_...
GITHUB_REDIRECT_URI=https://omniai-backend-qg4l.onrender.com/api/auth/oauth/github/callback

# Security, Safeguards & Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_SIZE_BYTES=15728640
REQUEST_TIMEOUT_SECONDS=45.0
