# OmniAI Production Environment Configuration
APP_NAME="OmniAI Backend"
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# In production, replace with your actual production frontend domain (e.g. https://omniai.example.com)
CORS_ORIGINS="https://omniai.example.com"

# API Keys (Provide via secret management or container env vars)
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Single-Tenant Production Access Control (Set a strong secret token to require auth)
APP_ACCESS_TOKEN=""

# Security & Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_SIZE_BYTES=15728640

# Logging & Documentation
LOG_LEVEL=INFO
ENABLE_DOCS=false

DEFAULT_MODEL="gemini-3.8-flash"
SQLITE_DB_PATH="data/omniai.db"
UPLOAD_DIR="data/uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

