# OmniAI Production Environment Configuration
APP_NAME="OmniAI Backend"
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# In production, replace with your actual production frontend domain (e.g. https://omniai.example.com)
CORS_ORIGINS="https://omniai.example.com"

# API Keys (Provide via secret management or container env vars)
GEMINI_API_KEY=""
GROQ_API_KEY=""

DEFAULT_MODEL="gemini-3.8-flash"
SQLITE_DB_PATH="data/omniai.db"
UPLOAD_DIR="data/uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

