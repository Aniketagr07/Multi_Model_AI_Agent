# ==============================================================================
# OmniAI Backend Configuration
# ==============================================================================

# Application Settings
APP_NAME=OmniAI Backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins for frontend communication
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# AI Provider Configuration (Day 3: Google Gemini API Free Tier)
# ==============================================================================
# Get your free API key at: https://aistudio.google.com/app/apikey
# Free tier includes: 15 Requests Per Minute (RPM), 1 Million Tokens Per Minute (TPM)
GEMINI_API_KEY=your_gemini_api_key_here

# Provider Endpoint & Default Model
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DEFAULT_MODEL=gemini-1.5-flash
ALLOWED_MODELS=gemini-1.5-flash,gemini-1.5-pro,gemini-2.0-flash-exp

# ==============================================================================
# Future Model Providers (Planned for Day 4+)
# ==============================================================================
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434
