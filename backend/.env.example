# ==============================================================================
# OmniAI Backend Configuration
# ==============================================================================

# Application Settings
APP_NAME=OmniAI Backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins for frontend communication
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# AI Provider 1: Google Gemini API (Free Tier)
# ==============================================================================
# Free API key at: https://aistudio.google.com/app/apikey
# Free tier: 15 Requests Per Minute (RPM), 1 Million Tokens Per Minute (TPM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DEFAULT_GEMINI_MODEL=gemini-3.8-flash

# ==============================================================================
# AI Provider 2: Groq Cloud API (Free Tier)
# ==============================================================================
# Free API key at: https://console.groq.com/keys
# Free tier: 30 Requests Per Minute (RPM), 6,000 Tokens Per Minute (TPM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_GROQ_MODEL=llama-3.1-8b-instant

# Global Defaults & Model Allowlist
DEFAULT_MODEL=gemini-3.8-flash
ALLOWED_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest,gemini-1.5-flash,gemini-1.5-pro,gemini-2.0-flash-exp,llama-3.1-8b-instant,llama-3.3-70b-versatile,mixtral-8x7b-32768

# ==============================================================================
# OAuth Authentication Providers: Google & GitHub
# ==============================================================================
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# GitHub Developer Settings: https://github.com/settings/developers
# Authorized Callback URL: http://localhost:5173/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback/github

# Server-side Session Secret (min 32 characters)
APP_SESSION_SECRET=
# Encryption secret for BYOK user API keys at rest (defaults to APP_SESSION_SECRET if unset)
API_KEY_ENCRYPTION_SECRET=

# ==============================================================================
# Database Configuration (Neon PostgreSQL for Production / SQLite for Dev)
# ==============================================================================
# In Production (Neon PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# In Local Development (defaults to SQLite if unset):
# SQLITE_DB_PATH=data/omniai.db
DATABASE_URL=
SQLITE_DB_PATH=data/omniai.db

